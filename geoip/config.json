{
  "input": [
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "telegram",
        "uri": "https://core.telegram.org/resources/cidr.txt"
      }
    },
    {
      "type": "dbipCountryMMDB",
      "action": "add",
      "args": {
        "uri": "./db-ip/dbip-country-lite.mmdb",
        "wantedList": [
          "ru"
        ],
        "onlyIPType": "ipv4"
      }
    },
    {
      "type": "private",
      "action": "add"
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputName": "geoip.dat",
        "wantedList": [
          "telegram",
          "ru",
          "private"
        ]
      }
    }
  ]
}
